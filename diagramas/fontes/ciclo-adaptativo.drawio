        <mxCell id="r2c2" value="O sistema pede confirmação&lt;br&gt;quando contas diferentes&lt;br&gt;reservam em pouco tempo." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;spacing=0;spacingTop=16;spacingLeft=16;spacingRight=16;spacingBottom=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1">
