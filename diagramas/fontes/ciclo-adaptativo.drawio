  <diagram id="ciclo-adaptativo" name="Ciclo adaptativo">
    <mxGraphModel dx="1540" dy="1220" grid="0" gridSize="10" page="1" pageScale="1" pageWidth="1540" pageHeight="1220" background="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r1c1" value="O usuário tenta reservar&lt;br&gt;vários horários usando&lt;br&gt;uma só conta." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;spacing=0;spacingTop=16;spacingLeft=16;spacingRight=16;spacingBottom=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="188" width="300" height="174" />
        </mxCell>
        <mxCell id="r1c2" value="O sistema passa a limitar&lt;br&gt;as reservas ativas de&lt;br&gt;cada conta." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;spacing=0;spacingTop=16;spacingLeft=16;spacingRight=16;spacingBottom=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="188" width="300" height="174" />
        </mxCell>
        <mxCell id="r1c3" value="Usuário: recebe recusas.&lt;br&gt;Sistema: vê muitas reservas&lt;br&gt;feitas na mesma conta." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;spacing=0;spacingTop=16;spacingLeft=16;spacingRight=16;spacingBottom=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="188" width="300" height="174" />
        </mxCell>
        <mxCell id="r1c4" value="Usuário: usa outras contas.&lt;br&gt;Sistema: passa a comparar&lt;br&gt;reservas entre contas." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;spacing=0;spacingTop=16;spacingLeft=16;spacingRight=16;spacingBottom=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="188" width="300" height="174" />
