        <mxCell id="r2c3" value="Usuário: recebe pedidos&lt;br&gt;de confirmação.&lt;br&gt;Sistema: vê muitos horários&lt;br&gt;ocupados apesar do limite." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=22;align=left;verticalAlign=top;spacing=0;spacingTop=16;spacingLeft=16;spacingRight=16;spacingBottom=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1">
